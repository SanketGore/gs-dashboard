 "tool_tests": [
  {
   "id": "total outstanding",
   "oracle": "total_outstanding",
   "kind": "number",
   "tol": 0.001,
   "code": "return getAllOutstanding().reduce((s,r)=>s+r.outstanding,0);"
  },
  {
   "id": "pending invoice count",
   "oracle": "pending_invoice_count",
   "kind": "number",
   "tol": 0,
   "code": "return getPendingInvoices(null).length;"
  },
  {
   "id": "top 5 debtors (order)",
   "oracle": "top5_outstanding",
   "kind": "names",
   "ordered": true,
   "code": "return getAllOutstanding().slice(0,5).map(r=>r.customer).join(' | ');"
  },
  {
   "id": "one customer: {C_TOP}",
   "oracle": "cust_outstanding:C_TOP",
   "kind": "number",
   "tol": 0.001,
   "code": "return getCustomerOutstanding({C_TOP:json}).total_outstanding;"
  },
  {
   "id": "one customer: {C_MID}",
   "oracle": "cust_outstanding:C_MID",
   "kind": "number",
   "tol": 0.001,
   "code": "return getCustomerOutstanding({C_MID:json}).total_outstanding;"
  }
 ],
